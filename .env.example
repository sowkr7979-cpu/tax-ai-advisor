# .env.example — copy to .env (gitignored) and fill in. NEVER commit real keys.
# Slice ⑥ deterministic tests need NONE of these (hermetic).

# LLM (default model: claude-opus-4-8)
ANTHROPIC_API_KEY=

# Embedding / reranker (multilingual/Korean)
EMBEDDING_API_KEY=

# Web research
TAVILY_API_KEY=
BRAVE_API_KEY=

# Korean-law MCP (chrisryugj/korean-law-mcp) — slice ①
#   Option A (no install): hosted endpoint below + LAW_OC
#   Option B (local stdio): `npm install -g korean-law-mcp`, endpoint=stdio
KOREAN_LAW_MCP_ENDPOINT=https://korean-law-mcp.fly.dev/mcp
LAW_OC=                 # 법제처 Open API 인증키(OC) — https://open.law.go.kr (무료 신청)

# DART (전자공시)
DART_API_KEY=

# OCR
OCR_API_KEY=
